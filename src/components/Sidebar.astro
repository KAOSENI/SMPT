---
import { STATIONS } from '../scripts/data/stations.js';
import { 
  Gauge, 
  Activity,
  CircleCheck,
  BarChart3
} from '@lucide/astro';

const total = STATIONS.length;
const fmCount = STATIONS.filter(s => s.band === 'FM').length;
const amCount = STATIONS.filter(s => s.band === 'AM').length;
---

<div class="sidebar">
  <!-- ============================================ -->
  <!-- 1. GAUGE + ESTADO (2 elementos en fila)     -->
  <!-- ============================================ -->
  <div class="sidebar-card double-card">
    <div class="double-row">
      <!-- Gauge Custom -->
      <div class="double-item gauge-item">
        <div class="card-header">
          <div class="card-header-left">
            <Activity size={16} stroke-width={2} class="card-icon" />
            <span class="card-title">Disponibilidad</span>
          </div>
        </div>
        <div class="gauge-wrapper">
          <div id="gauge-chart" class="gauge-chart"></div>
        </div>
      </div>

      <!-- Anillo Estado Transmisores -->
      <div class="double-item pie-item">
        <div class="card-header">
          <div class="card-header-left">
            <Activity size={16} stroke-width={2} class="card-icon" />
            <span class="card-title">Estado</span>
          </div>
          <button class="stats-btn" id="open-stats-btn" title="Ver estadísticas detalladas">
            <BarChart3 size={14} stroke-width={2} />
          </button>
        </div>
        <div class="pie-wrapper">
          <div id="pie-status" class="pie-chart"></div>
          <div class="pie-legend">
            <div class="pie-legend-item">
              <span class="pie-dot ok-dot"></span>
              <span class="pie-label">Operativos</span>
              <span class="pie-value" id="sidebar-ok-value">0</span>
            </div>
            <div class="pie-legend-item">
              <span class="pie-dot warn-dot"></span>
              <span class="pie-label">Advertencia</span>
              <span class="pie-value" id="sidebar-warn-value">0</span>
            </div>
            <div class="pie-legend-item">
              <span class="pie-dot crit-dot"></span>
              <span class="pie-label">Críticos</span>
              <span class="pie-value" id="sidebar-crit-value">0</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- 2. ACTIVIDAD RECIENTE                       -->
  <!-- ============================================ -->
  <div class="sidebar-card events-card">
    <div class="card-header">
      <div class="card-header-left">
        <CircleCheck size={16} stroke-width={2} class="card-icon" />
        <span class="card-title">Actividad reciente</span>
      </div>
      <span class="card-badge" id="sidebar-event-count">0 eventos</span>
    </div>
    <div class="sidebar-events" id="sidebar-events">
      <div class="events-empty">Esperando eventos...</div>
    </div>
    <span id="sidebar-last" style="display:none;">—</span>
  </div>

  <div style="display:none;" aria-hidden="true">
    <span id="sidebar-total">{total}</span>
    <span id="sidebar-fm">{fmCount}</span>
    <span id="sidebar-am">{amCount}</span>
  </div>
</div>

<!-- ============================================ -->
<!-- 3. VENTANA FLOTANTE DE ESTADÍSTICAS         -->
<!-- ============================================ -->
<div id="stats-overlay" class="stats-overlay">
  <div class="stats-modal">
    <div class="stats-header">
      <h2 class="stats-title">
        <BarChart3 size={20} stroke-width={2} />
        Estadísticas detalladas
      </h2>
      <button class="stats-close" id="close-stats-btn">✕</button>
    </div>
    <div class="stats-body">
      <div class="stats-row">
        <div class="stats-item">
          <div class="stats-item-label">Disponibilidad</div>
          <div class="stats-item-value" id="stats-availability">64%</div>
          <div class="stats-item-bar">
            <div class="stats-item-bar-fill" id="stats-availability-bar" style="width: 64%;"></div>
          </div>
        </div>
        <div class="stats-item">
          <div class="stats-item-label">Distribución por banda</div>
          <div class="stats-band">
            <span class="stats-band-item">
              <span class="stats-dot fm"></span> FM: <strong id="stats-fm">7</strong>
            </span>
            <span class="stats-band-item">
              <span class="stats-dot am"></span> AM: <strong id="stats-am">4</strong>
            </span>
          </div>
        </div>
      </div>

      <div class="stats-row">
        <div class="stats-item">
          <div class="stats-item-label">Estado de transmisores</div>
          <div class="stats-status-grid">
            <div class="stats-status-item ok-bg">
              <span class="stats-status-dot ok-dot"></span>
              <span class="stats-status-label">Operativos</span>
              <span class="stats-status-value" id="stats-ok">0</span>
            </div>
            <div class="stats-status-item warn-bg">
              <span class="stats-status-dot warn-dot"></span>
              <span class="stats-status-label">Advertencia</span>
              <span class="stats-status-value" id="stats-warn">0</span>
            </div>
            <div class="stats-status-item crit-bg">
              <span class="stats-status-dot crit-dot"></span>
              <span class="stats-status-label">Críticos</span>
              <span class="stats-status-value" id="stats-crit">0</span>
            </div>
          </div>
        </div>
        <div class="stats-item">
          <div class="stats-item-label">Resumen</div>
          <div class="stats-summary">
            <div class="stats-summary-item">
              <span>Total transmisores</span>
              <strong id="stats-total">11</strong>
            </div>
            <div class="stats-summary-item">
              <span>Última actualización</span>
              <strong id="stats-last-update">--:--:--</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="stats-row">
        <div class="stats-item">
          <div class="stats-item-label">Promedios de la red</div>
          <div class="stats-summary">
            <div class="stats-summary-item">
              <span>Potencia promedio</span>
              <strong id="stats-avg-power">—</strong>
            </div>
            <div class="stats-summary-item">
              <span>ROE promedio</span>
              <strong id="stats-avg-vswr">—</strong>
            </div>
            <div class="stats-summary-item">
              <span>Temperatura promedio</span>
              <strong id="stats-avg-temp">—</strong>
            </div>
          </div>
        </div>
        <div class="stats-item">
          <div class="stats-item-label">Alimentación y equipos</div>
          <div class="stats-summary">
            <div class="stats-summary-item">
              <span>Fases eléctricas caídas</span>
              <strong id="stats-phase-down">—</strong>
            </div>
            <div class="stats-summary-item">
              <span>Equipos instalados apagados</span>
              <strong id="stats-equip-off">—</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="stats-item">
        <div class="stats-item-label">Transmisores (ordenados por severidad)</div>
        <div class="stats-table-wrap">
          <table class="stats-table">
            <thead>
              <tr>
                <th></th>
                <th>Transmisor</th>
                <th>Potencia</th>
                <th>ROE</th>
                <th>Temp.</th>
                <th>Motivo</th>
              </tr>
            </thead>
            <tbody id="stats-table-body"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { state } from '../scripts/state.js';
  import { statusOf, statusReasons } from '../scripts/status.js';

  // ============================================================
  // FUNCIONES DE ESTADO
  // ============================================================
  // Antes esto dependía de window.__APP_STATE__ (nunca se asignaba en
  // ningún archivo del proyecto) o, si eso fallaba, releía el texto ya
  // pintado en otros elementos del sidebar (frágil: si ese texto no se
  // había actualizado todavía, se propagaba el valor viejo). Ahora se
  // calcula una sola vez desde `state`, la misma fuente de verdad que usa
  // el resto de la app (grid, mapa, tarjetas de detalle).

  function getStatusCounts(): { ok: number; warn: number; crit: number } {
    let ok = 0, warn = 0, crit = 0;
    state.forEach(tx => {
      const s = statusOf(tx);
      if (s === 'ok') ok++;
      else if (s === 'warn') warn++;
      else crit++;
    });
    return { ok, warn, crit };
  }

  // Disponibilidad ponderada: ok=100%, warn=50%, crit=0% (mismo criterio
  // que dashboard.js). Se calcula aquí también porque el gauge y el modal
  // de estadísticas viven en este componente y necesitan el número real,
  // no un valor leído (y a veces inexistente) de otro elemento del DOM.
  function getAvailability(): number {
    const { ok, warn, crit } = getStatusCounts();
    const total = ok + warn + crit;
    if (total === 0) return 0;
    return Math.round(((ok * 100) + (warn * 50)) / total);
  }

  function updateStatusValues(ok: number, warn: number, crit: number): void {
    const okEl = document.getElementById('sidebar-ok-value');
    const warnEl = document.getElementById('sidebar-warn-value');
    const critEl = document.getElementById('sidebar-crit-value');
    if (okEl) okEl.textContent = String(ok);
    if (warnEl) warnEl.textContent = String(warn);
    if (critEl) critEl.textContent = String(crit);
  }

  // ============================================================
  // FUNCIONES DEL MODAL
  // ============================================================

  // Mientras el modal está abierto, se refresca en cada tick (ver el hook
  // window.__refreshStatsModal más abajo, y tick.js). Antes solo se
  // actualizaba una vez al abrirlo y se quedaba congelado.
  let statsModalOpen = false;

  function openStatsModal(): void {
    const overlay = document.getElementById('stats-overlay');
    if (!overlay) return;
    
    try {
      statsModalOpen = true;
      updateStatsModal();
      overlay.style.display = 'flex';
      void overlay.offsetHeight;
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    } catch {}
  }

  function closeStatsModal(): void {
    const overlay = document.getElementById('stats-overlay');
    if (!overlay) return;
    
    statsModalOpen = false;
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
    
    setTimeout(() => {
      if (!overlay.classList.contains('is-open')) {
        overlay.style.display = 'none';
      }
    }, 400);
  }

  // ============================================================
  // ACTUALIZACIÓN DEL MODAL
  // ============================================================

  function updateStatsModal(): void {
    try {
      const counts = getStatusCounts();
      const total = state.length;
      const fm = parseInt(document.getElementById('sidebar-fm')?.textContent || '0') || 0;
      const am = parseInt(document.getElementById('sidebar-am')?.textContent || '0') || 0;
      const availability = getAvailability();

      const elements = {
        availability: document.getElementById('stats-availability'),
        availabilityBar: document.getElementById('stats-availability-bar'),
        fm: document.getElementById('stats-fm'),
        am: document.getElementById('stats-am'),
        ok: document.getElementById('stats-ok'),
        warn: document.getElementById('stats-warn'),
        crit: document.getElementById('stats-crit'),
        total: document.getElementById('stats-total'),
        lastUpdate: document.getElementById('stats-last-update')
      };
      
      if (elements.availability) {
        elements.availability.textContent = availability + '%';
      }
      
      if (elements.availabilityBar) {
        elements.availabilityBar.style.width = availability + '%';
      }
      
      if (elements.fm) elements.fm.textContent = String(fm);
      if (elements.am) elements.am.textContent = String(am);
      if (elements.ok) elements.ok.textContent = String(counts.ok);
      if (elements.warn) elements.warn.textContent = String(counts.warn);
      if (elements.crit) elements.crit.textContent = String(counts.crit);
      if (elements.total) elements.total.textContent = String(total);

      if (elements.lastUpdate) {
        elements.lastUpdate.textContent = new Date().toLocaleTimeString('es-MX', {
          hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
        });
      }

      // Promedios de la red — dan una lectura de conjunto que los conteos
      // ok/warn/crit por sí solos no muestran (p. ej. la red puede estar
      // "toda en ok" pero con el ROE promedio subiendo poco a poco).
      const avgPower = state.reduce((sum, tx) => sum + tx.power, 0) / total;
      const avgVswr = state.reduce((sum, tx) => sum + tx.vswr, 0) / total;
      const avgTemp = state.reduce((sum, tx) => sum + tx.temp, 0) / total;

      const avgPowerEl = document.getElementById('stats-avg-power');
      if (avgPowerEl) avgPowerEl.textContent = avgPower.toFixed(0) + '%';
      const avgVswrEl = document.getElementById('stats-avg-vswr');
      if (avgVswrEl) avgVswrEl.textContent = avgVswr.toFixed(2) + ':1';
      const avgTempEl = document.getElementById('stats-avg-temp');
      if (avgTempEl) avgTempEl.textContent = avgTemp.toFixed(1) + '°C';

      // Fases eléctricas caídas — solo cuenta transmisores con monitoreo de
      // fase configurado (los que no tienen, no aplican).
      let phaseDown = 0;
      state.forEach((tx) => {
        const pm = tx.config.phaseMonitoring;
        if (pm === 0) return;
        const aOk = tx.phaseA;
        const bOk = pm === 2 ? tx.phaseB : true;
        if (!aOk || !bOk) phaseDown++;
      });
      const phaseDownEl = document.getElementById('stats-phase-down');
      if (phaseDownEl) phaseDownEl.textContent = String(phaseDown);

      // Equipos instalados pero apagados, sumados en toda la red.
      let equipOff = 0;
      state.forEach((tx) => {
        Object.values(tx.equipment).forEach((eq: any) => {
          if (eq.installed && !eq.on) equipOff++;
        });
      });
      const equipOffEl = document.getElementById('stats-equip-off');
      if (equipOffEl) equipOffEl.textContent = String(equipOff);

      // Tabla completa, ordenada por severidad (crítico primero, luego
      // advertencia, luego ok) para que los problemas queden arriba sin
      // tener que buscarlos. Cada fila abre el detalle de ese transmisor.
      const severityRank: Record<string, number> = { crit: 0, warn: 1, ok: 2 };
      const rows = [...state].sort((a, b) => {
        const diff = severityRank[statusOf(a)] - severityRank[statusOf(b)];
        return diff !== 0 ? diff : a.shortName.localeCompare(b.shortName);
      });

      const tbody = document.getElementById('stats-table-body');
      if (tbody) {
        tbody.innerHTML = rows.map((tx) => {
          const s = statusOf(tx);
          const reasons = s === 'ok' ? [] : statusReasons(tx);
          return `
            <tr onclick="closeStatsModal(); openDetail(${tx.id});">
              <td><span class="stats-status-dot ${s}-dot"></span></td>
              <td>${tx.shortName}</td>
              <td>${tx.power.toFixed(0)}%</td>
              <td>${tx.vswr.toFixed(2)}:1</td>
              <td>${tx.temp.toFixed(1)}°C</td>
              <td class="stats-table-reason">${reasons.join(' · ')}</td>
            </tr>`;
        }).join('');
      }
    } catch {}
  }

  // Se llama en cada tick (ver window.__refreshStatsModal más abajo) — pero
  // solo hace trabajo real si el modal sigue abierto, igual que openDetail()/
  // openSettings() en tick.js solo refrescan si su ventana está abierta.
  function refreshStatsModalIfOpen(): void {
    if (statsModalOpen) updateStatsModal();
  }

  // ============================================================
  // INICIALIZACIÓN DE GRÁFICAS
  // ============================================================

  async function initSidebarCharts(): Promise<void> {
    try {
      const echarts = await import('echarts');
      (window as any)._echartsLib = echarts;

      const gaugeDom = document.getElementById('gauge-chart');
      if (gaugeDom) {
        window._gaugeChart = echarts.init(gaugeDom, null, { renderer: 'svg' });
        updateGaugeChart();
      }

      const statusDom = document.getElementById('pie-status');
      if (statusDom) {
        const statusChart = echarts.init(statusDom, null, { renderer: 'svg' });
        window._statusPie = statusChart;
        const counts = getStatusCounts();
        updateStatusPie(counts.ok, counts.warn, counts.crit);
        setTimeout(() => statusChart.resize(), 200);
      }

      window.addEventListener('resize', () => {
        window._gaugeChart?.resize();
        window._statusPie?.resize();
      });

    } catch {}
  }

  // ============================================================
  // CUSTOM GAUGE
  // ============================================================

  function updateGaugeChart(): void {
    const chart = window._gaugeChart;
    if (!chart) return;

    renderGaugeArc(chart, getAvailability());
  }

  function getGaugeStatus(availability: number): { color: string; from: string; to: string; label: string } {
    if (availability < 50) {
      return { color: '#ef4444', from: '#dc2626', to: '#f87171', label: 'Crítico' };
    }
    if (availability < 75) {
      return { color: '#eab308', from: '#ca8a04', to: '#fbbf24', label: 'Advertencia' };
    }
    return { color: '#22c55e', from: '#16a34a', to: '#4ade80', label: 'Óptimo' };
  }

  function renderGaugeArc(chart: any, availability: number): void {
    const status = getGaugeStatus(availability);
    const echartsLib = (window as any)._echartsLib;

    const renderItem = (params: any, api: any) => {
      const valOnRadian = api.value(1);
      const coords = api.coord([api.value(0), valOnRadian]);
      const polarEndRadian = coords[3];
      const cx = params.coordSys.cx;
      const cy = params.coordSys.cy;
      const r = Math.min(cx, cy) * 0.85;
      const r0 = r * 0.72;
      const thickness = r - r0;

      const progressFill = echartsLib
        ? new echartsLib.graphic.LinearGradient(0, 0, 1, 1, [
            { offset: 0, color: status.from },
            { offset: 1, color: status.to }
          ])
        : status.color;

      return {
        type: 'group',
        children: [
          {
            type: 'sector',
            shape: { cx, cy, r, r0, startAngle: 0, endAngle: -Math.PI * 2 },
            style: { fill: 'var(--panel-line, #e5e7eb)', opacity: 0.45 }
          },
          {
            type: 'sector',
            shape: {
              cx, cy, r, r0,
              startAngle: 0,
              endAngle: -polarEndRadian,
              cornerRadius: thickness / 2,
              transition: 'endAngle',
              enterFrom: { endAngle: 0 }
            },
            style: {
              fill: progressFill,
              shadowBlur: 18,
              shadowColor: status.color + '55',
              shadowOffsetY: 2
            }
          },
          {
            type: 'text',
            extra: { valOnRadian, transition: 'valOnRadian', enterFrom: { valOnRadian: 0 } },
            style: {
              text: `${Math.round(valOnRadian)}%`,
              fontSize: 24,
              fontWeight: 800,
              fontFamily: 'var(--mono, monospace)',
              x: cx,
              y: cy,
              fill: 'var(--text, #111827)',
              align: 'center',
              verticalAlign: 'middle'
            },
            during: (apiDuring: any) => apiDuring.setStyle('text', `${Math.round(apiDuring.getExtra('valOnRadian'))}%`)
          }
        ]
      };
    };

    chart.setOption({
      animationDuration: 900,
      animationDurationUpdate: 900,
      animationEasingUpdate: 'backOut',
      dataset: { source: [[1, availability]] },
      angleAxis: { type: 'value', startAngle: 0, show: false, min: 0, max: 100 },
      radiusAxis: { type: 'value', show: false },
      polar: { radius: '100%', center: ['50%', '50%'] },
      series: [{ type: 'custom', coordinateSystem: 'polar', renderItem }]
    });
  }

  // ============================================================
  // PIE DE ESTADO
  // ============================================================

  function updateStatusPie(ok: number, warn: number, crit: number): void {
    const chart = window._statusPie;
    if (!chart) return;
    const total = ok + warn + crit;
    updateStatusValues(ok, warn, crit);

    const isEmpty = total === 0;

    chart.setOption({
      series: [{
        type: 'pie',
        radius: ['48%', '85%'],
        center: ['50%', '50%'],
        startAngle: 120,
        avoidLabelOverlap: false,
        itemStyle: { borderRadius: 4, borderColor: 'var(--panel, #ffffff)', borderWidth: 2 },
        label: {
          show: true,
          position: 'center',
          formatter: `{total|${isEmpty ? 0 : total}}`,
          rich: { 
            total: { 
              fontSize: 26, 
              fontWeight: '800', 
              color: 'var(--text, #111827)', 
              fontFamily: 'var(--mono, monospace)' 
            } 
          }
        },
        labelLine: { show: false },
        data: isEmpty
          ? [{ value: 1, name: 'Sin datos', itemStyle: { color: 'var(--panel-line, #e5e7eb)' } }]
          : [
              { value: ok, name: 'Operativos', itemStyle: { color: '#22c55e' } },
              { value: warn, name: 'Advertencia', itemStyle: { color: '#eab308' } },
              { value: crit, name: 'Críticos', itemStyle: { color: '#ef4444' } }
            ]
      }]
    });
  }

  // ============================================================
  // ACTUALIZACIÓN PRINCIPAL
  // ============================================================

  function updateBarsChart(): void {
    const counts = getStatusCounts();
    updateStatusPie(counts.ok, counts.warn, counts.crit);
    updateGaugeChart();
  }

  function updateSidebarGauge(availability: number): void {
    const chart = window._gaugeChart;
    if (!chart) return;
    renderGaugeArc(chart, availability);
  }

  // Exponer funciones globalmente
  window.updateBarsChart = updateBarsChart;
  window.updateStatusPie = updateStatusPie;
  window.updateSidebarGauge = updateSidebarGauge;
  window.__updateSidebarStatus = function(ok: number, warn: number, crit: number): void {
    updateStatusPie(ok, warn, crit);
  };
  window.openStatsModal = openStatsModal;
  window.closeStatsModal = closeStatsModal;
  window.__refreshStatsModal = refreshStatsModalIfOpen;

  // ============================================================
  // CONFIGURACIÓN DE EVENTOS
  // ============================================================

  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('open-stats-btn');
    if (openBtn) {
      openBtn.addEventListener('click', (e) => {
        e.preventDefault();
        openStatsModal();
      });
    }
    
    const closeBtn = document.getElementById('close-stats-btn');
    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        closeStatsModal();
      });
    }
    
    const overlay = document.getElementById('stats-overlay');
    if (overlay) {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          closeStatsModal();
        }
      });
    }
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeStatsModal();
      }
    });
  });

  // ============================================================
  // INICIALIZACIÓN
  // ============================================================

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSidebarCharts);
  } else {
    initSidebarCharts();
  }

  // ============================================================
  // SIMETRÍA CON EL MAPA
  // ============================================================

  function setupStrictSimetry(): void {
    const mapContainer = document.getElementById('geo-map');
    const sidebarEl = document.querySelector('.sidebar');
    if (!mapContainer || !(sidebarEl instanceof HTMLElement)) return;

    const layoutObserver = new ResizeObserver((entries) => {
      for (const entry of entries) {
        if (window.innerWidth > 1024) {
          const exactHeight = entry.contentRect.height;
          sidebarEl.style.height = `${exactHeight}px`;
          sidebarEl.style.maxHeight = `${exactHeight}px`;
          requestAnimationFrame(() => {
            window._gaugeChart?.resize();
            window._statusPie?.resize();
          });
        } else {
          sidebarEl.style.height = 'auto';
          sidebarEl.style.maxHeight = 'none';
        }
      }
    });
    layoutObserver.observe(mapContainer);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupStrictSimetry);
  } else {
    setupStrictSimetry();
  }
</script>

<style>
  /* ============================================================
     ESTILOS DEL MODAL (Integración con tu modal.css)
     ============================================================ */
  
  #stats-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(9, 13, 11, 0.45);
    backdrop-filter: blur(8px);
