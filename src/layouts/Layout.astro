---
// Layout base: importa todas las hojas de estilo (Astro/Vite las agrupa en un
// solo CSS al compilar) y arma el esqueleto <html>. Para tocar SOLO el look
// visual de un apartado, edita el archivo correspondiente en src/styles/ —
// no hace falta tocar este layout.
import '../styles/theme.css';
import '../styles/base.css';
import '../styles/map.css';
import '../styles/sidebar.css';
import '../styles/cards.css';
import '../styles/modal.css';
import '../styles/footer.css';
import '../styles/responsive.css';
import '../styles/about.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Red de Transmisores — Panel de Monitoreo',
  description = 'Panel de monitoreo en tiempo real de los 11 transmisores del Sistema Chiapaneco de Radio, Televisión y Cinematografía: potencia, ROE, temperatura, alimentación eléctrica y estado por transmisor.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
// Asegurar que base tenga la barra al final
const baseUrl = base.endsWith('/') ? base : `${base}/`;
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = Astro.site ? new URL(`${baseUrl}logo-schrtyc.png`, Astro.site).toString() : `${baseUrl}logo-schrtyc.png`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- ===== FAVICONS (con barra después de base) ===== -->
  <!-- iOS / Safari -->
  <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png`} />
  
  <!-- Navegadores antiguos / favoritos -->
  <link rel="shortcut icon" href={`${baseUrl}favicon.ico`} />
  
  <!-- Navegadores modernos con soporte SVG -->
  <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
  
  <!-- PNG de respaldo -->
  <link rel="icon" type="image/png" sizes="96x96" href={`${baseUrl}favicon-96x96.png`} />
  
  <!-- Manifest para PWA / Chrome -->
  <link rel="manifest" href={`${baseUrl}site.webmanifest`} />

  <!-- ===== META TAGS ===== -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  {siteUrl && <meta property="og:url" content={siteUrl} />}

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script is:inline>
    // Aplica el tema guardado ANTES de que el navegador pinte la página.
    (function () {
      try {
        var theme = localStorage.getItem('smpt:theme:v1');
        if (theme) document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <slot />
</body>
</html>